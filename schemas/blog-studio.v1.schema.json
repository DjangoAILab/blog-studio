{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "site": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["displayName"],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "maxInputBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 104857600
        },
        "allowedMediaTypes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "application/pdf",
              "application/zip",
              "text/plain"
            ]
          }
        },
        "inlinePreviewMediaTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "application/pdf",
              "application/zip",
              "text/plain"
            ]
          }
        }
      },
      "required": ["maxInputBytes", "allowedMediaTypes"],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "root"],
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "collections": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "draftPath": {
                "type": "string",
                "minLength": 1
              },
              "assetScope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "list", "object"]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              "required": {
                "type": "boolean"
              },
              "searchable": {
                "type": "boolean"
              },
              "sortable": {
                "type": "boolean"
              },
              "enum": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "default": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": ["label", "type"],
            "additionalProperties": false
          }
        }
      },
      "required": ["collections"],
      "additionalProperties": false
    },
    "developmentProfiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?:[A-Za-z0-9]|\\/)[A-Za-z0-9._/-]*$"
          },
          "args": {
            "default": [],
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "previewUrl": {
            "type": "string",
            "format": "uri"
          },
          "readinessPath": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^\\/[A-Za-z0-9._~!$&'()*+,;=:@/%-]*$"
          },
          "environmentAllowlist": {
            "default": [],
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            }
          },
          "startupTimeoutMs": {
            "default": 30000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          },
          "logLimit": {
            "default": 500,
            "type": "integer",
            "minimum": 10,
            "maximum": 2000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "command",
          "args",
          "baseUrl",
          "environmentAllowlist",
          "startupTimeoutMs",
          "logLimit",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "development": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?:[A-Za-z0-9]|\\/)[A-Za-z0-9._/-]*$"
        },
        "args": {
          "default": [],
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "previewUrl": {
          "type": "string",
          "format": "uri"
        },
        "readinessPath": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^\\/[A-Za-z0-9._~!$&'()*+,;=:@/%-]*$"
        },
        "environmentAllowlist": {
          "default": [],
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        },
        "startupTimeoutMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "logLimit": {
          "default": 500,
          "type": "integer",
          "minimum": 10,
          "maximum": 2000
        }
      },
      "required": [
        "command",
        "args",
        "baseUrl",
        "environmentAllowlist",
        "startupTimeoutMs",
        "logLimit"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["baseUrl"],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "workspace",
    "generator",
    "repository",
    "assets",
    "publish"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
