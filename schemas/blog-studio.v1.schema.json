{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "site": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["displayName"],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "root"],
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "credentials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "required": ["env"],
            "additionalProperties": false
          }
        }
      },
      "required": ["adapter", "options"],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "collections": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "draftPath": {
                "type": "string",
                "minLength": 1
              },
              "assetScope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        }
      },
      "required": ["collections"],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["baseUrl"],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "workspace",
    "generator",
    "repository",
    "assets",
    "publish"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
