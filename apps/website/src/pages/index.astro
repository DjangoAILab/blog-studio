---
import '../styles/landing.css';

const stages = [
  ['01', 'Write', 'Markdown and unknown front matter stay in your repository.'],
  ['02', 'Preview', 'Build the real site with its generator and theme.'],
  ['03', 'Release', 'See every upload, cache, and verification stage.'],
  ['04', 'Recover', 'Retry safely or restore the last verified manifest.'],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Blog Studio is a self-hosted publishing workbench for file-based static sites."
    />
    <meta name="theme-color" content="#1d2824" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Blog Studio — Write where your site already lives</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Blog Studio home">
        <span class="brand-mark" aria-hidden="true">文</span>
        <span>BLOG <i>/</i> STUDIO</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#journey">How it works</a>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/DjangoAILab/blog-studio">GitHub</a>
      </nav>
      <a class="header-cta" href="/docs/guides/self-hosting/"
        >Self-host it <span>↗</span></a
      >
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="kicker"><span></span> SELF-HOSTED PUBLISHING WORKBENCH</p>
          <h1 id="hero-title">Write where your site <em>already lives.</em></h1>
          <p class="hero-lede">
            Keep Markdown, Git, your generator, and your hosting. Replace the
            fragile chain of sync scripts and opaque deploys with one calm,
            verifiable browser journey.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/docs/"
              >Read the quick start <span>→</span></a
            >
            <a
              class="text-link"
              href="https://github.com/DjangoAILab/blog-studio"
              >Explore the source <span>↗</span></a
            >
          </div>
          <dl class="proof-strip" aria-label="Verified product properties">
            <div><dt>0</dt><dd>browser-side cloud credentials</dd></div>
            <div><dt>7</dt><dd>visible release stages</dd></div>
            <div><dt>5</dt><dd>replaceable adapter boundaries</dd></div>
          </dl>
        </div>

        <div class="studio-window" aria-label="Blog Studio product preview">
          <div class="window-bar">
            <span>BLOG <i>/</i> STUDIO</span>
            <span class="window-status"><b></b> Draft saved</span>
            <span class="window-action">Publish →</span>
          </div>
          <div class="window-body">
            <aside class="article-list">
              <p>ARTICLES <span>24</span></p>
              <div class="search-line">⌕ Search</div>
              <ul>
                <li class="active">
                  <b>Designing for durable calm</b><small
                    >Draft · just now</small
                  >
                </li>
                <li>
                  <b>A practical release manifest</b><small
                    >Published · Aug 01</small
                  >
                </li>
                <li>
                  <b>Why files remain canonical</b><small
                    >Published · Jul 28</small
                  >
                </li>
              </ul>
            </aside>
            <article class="editor-sheet">
              <p class="sheet-meta">ESSAY · 7 MIN READ</p>
              <h2>Designing for<br />durable calm</h2>
              <p class="sheet-intro">
                Publishing should preserve momentum, not interrupt it.
              </p>
              <div class="sheet-rule"></div>
              <p>
                A draft can be immediate without making production casual. The
                editor saves first; the release pipeline explains every step.
              </p>
              <blockquote>
                Files stay portable. Releases become observable.
              </blockquote>
            </article>
            <aside class="release-card">
              <p class="release-label">RELEASE / 0284</p>
              <h3>Ready to publish</h3>
              <ol>
                <li class="done">
                  <span>✓</span><b>Preflight</b><small>0.2s</small>
                </li>
                <li class="done">
                  <span>✓</span><b>Build site</b><small>3.8s</small>
                </li>
                <li class="current">
                  <span>3</span><b>Plan diff</b><small>4 files</small>
                </li>
                <li>
                  <span>4</span><b>Upload & verify</b><small>waiting</small>
                </li>
              </ol>
              <div class="release-summary">
                <span>+3 changed</span><span>0 deleted</span>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="principle-band" aria-label="Product principle">
        <p>YOUR SITE IS NOT A DATABASE ROW.</p>
        <h2>Files remain canonical.<br /><em>The workflow gets better.</em></h2>
        <p class="principle-note">
          Blog Studio sits beside the stack you trust. If it stops, your public
          site keeps serving.
        </p>
      </section>

      <section class="journey" id="journey" aria-labelledby="journey-title">
        <div class="section-heading">
          <p class="kicker"><span></span> ONE CONTINUOUS JOURNEY</p>
          <h2 id="journey-title">
            From first sentence<br />to verified release.
          </h2>
        </div>
        <ol class="journey-grid">
          {
            stages.map(([number, title, description]) => (
              <li>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{description}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="architecture" aria-labelledby="architecture-title">
        <div>
          <p class="kicker"><span></span> ADAPTERS, NOT ASSUMPTIONS</p>
          <h2 id="architecture-title">
            Hexo is the first proof.<br />Not the product boundary.
          </h2>
          <p>
            Generator, repository, assets, publisher, and cache are versioned
            contracts. The first vertical targets Hexo and Tencent's static-site
            stack; the core remains provider-independent.
          </p>
          <a class="text-link" href="/docs/adapters/overview/"
            >Understand the architecture <span>→</span></a
          >
        </div>
        <div class="adapter-map" aria-label="Adapter architecture diagram">
          <div class="map-core">
            <small>MODULAR CORE</small><b>Blog Studio</b><span
              >drafts · jobs · release state</span
            >
          </div>
          <div class="map-line"></div>
          <ul>
            <li><small>GENERATOR</small><b>Hexo</b></li>
            <li><small>REPOSITORY</small><b>Local Git</b></li>
            <li><small>ASSETS</small><b>Filesystem / COS</b></li>
            <li><small>PUBLISH</small><b>Filesystem / COS</b></li>
            <li><small>CACHE</small><b>None / Tencent</b></li>
          </ul>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="cta-title">
        <p>APACHE-2.0 · SELF-HOSTED · SINGLE-USER V0.1</p>
        <h2 id="cta-title">Make publishing feel<br />like writing again.</h2>
        <div>
          <a class="button button-paper" href="/docs/guides/self-hosting/"
            >Start self-hosting <span>→</span></a
          >
          <a href="https://github.com/DjangoAILab/blog-studio"
            >DjangoAILab / blog-studio ↗</a
          >
        </div>
      </section>
    </main>

    <footer>
      <a class="brand" href="/"
        ><span class="brand-mark" aria-hidden="true">文</span><span
          >BLOG <i>/</i> STUDIO</span
        ></a
      >
      <p>A publishing workbench for sites that belong to files.</p>
      <p>Apache-2.0 · Built in the open</p>
    </footer>
  </body>
</html>
