---
import { localePath } from '../lib/locales';
const destination = localePath('en');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Blog Studio</title>
  </head>
  <body>
    <p>Continue to <a href={destination}>Blog Studio in English</a>.</p>
  </body>
</html>
