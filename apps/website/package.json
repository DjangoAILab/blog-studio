{
  "name": "@blog-studio/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:lighthouse": "pnpm build && node scripts/audit-lighthouse.mjs",
    "build": "pnpm docs:generate && astro build && node scripts/check-links.mjs",
    "dev": "pnpm docs:generate && astro dev",
    "docs:generate": "node scripts/generate-reference.mjs",
    "e2e": "pnpm build && playwright test",
    "lint": "pnpm docs:generate && astro sync && eslint src/index.ts src/content.config.ts test e2e playwright.config.ts vitest.config.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "pnpm docs:generate && astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.6",
    "@fontsource-variable/ibm-plex-sans": "5.2.8",
    "@fontsource-variable/newsreader": "5.2.9",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1"
  }
}
