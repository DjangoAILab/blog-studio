BLOG_STUDIO_CONFIG_PATHS=/config/blog-studio.yml
BLOG_STUDIO_WORKSPACE_ROOT=/workspaces
BLOG_STUDIO_DATABASE_PATH=/data/blog-studio.sqlite
# Optional v0.1 migration fallback only. Normal deployments omit both legacy
# switches and initialize the owner password with the trusted CLI.
# BLOG_STUDIO_AUTH_TOKEN_FILE=/run/secrets/auth_token
# BLOG_STUDIO_ALLOW_LEGACY_RELEASE_API=false
BLOG_STUDIO_COOKIE_SECRET_FILE=/run/secrets/cookie_secret
BLOG_STUDIO_ALLOWED_ORIGINS=https://blog-editor.internal.example.com
BLOG_STUDIO_SECURE_COOKIES=true
