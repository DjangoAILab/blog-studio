    "@blog-studio/agent-runtime-pi": "workspace:*",
    "@blog-studio/assets": "workspace:*",
    "@blog-studio/cache-tencent": "workspace:*",
    "@blog-studio/config": "workspace:*",
    "@blog-studio/core": "workspace:*",
    "@blog-studio/persistence": "workspace:*",
    "@blog-studio/publisher-cos": "workspace:*",
    "@blog-studio/publisher-filesystem": "workspace:*",
    "@blog-studio/release": "workspace:*",
    "@blog-studio/storage-cos": "workspace:*",
    "@blog-studio/storage-filesystem": "workspace:*",
    "@fastify/cookie": "11.1.2",
