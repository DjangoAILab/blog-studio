{
  "name": "@blog-studio/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "node dist/server/cli.js auth",
    "build": "vite build && tsc -p tsconfig.server.json",
    "dev": "vite",
    "e2e": "corepack pnpm build && playwright test",
    "record:agent-demo": "bash scripts/record-agent-demo.sh",
    "lint": "eslint src server test e2e playwright.config.ts vitest.config.ts",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@blog-studio/adapter-command": "workspace:*",
    "@blog-studio/adapter-hexo": "workspace:*",
    "@blog-studio/adapter-local-git": "workspace:*",
    "@blog-studio/agent-runtime-pi": "workspace:*",
    "@blog-studio/assets": "workspace:*",
    "@blog-studio/cache-tencent": "workspace:*",
    "@blog-studio/config": "workspace:*",
    "@blog-studio/core": "workspace:*",
    "@blog-studio/persistence": "workspace:*",
    "@blog-studio/publisher-cos": "workspace:*",
    "@blog-studio/publisher-filesystem": "workspace:*",
    "@blog-studio/release": "workspace:*",
    "@blog-studio/storage-cos": "workspace:*",
    "@blog-studio/storage-filesystem": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.5",
    "@milkdown/crepe": "7.22.2",
