    "@yaireo/tagify": "^4.39.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "fastify": "5.12.5",
    "micromark": "4.0.3",
    "motion": "^14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tencentcloud-sdk-nodejs-cdn": "4.1.307",
    "tencentcloud-sdk-nodejs-teo": "4.1.319",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "sharp": "0.35.5",
    "vite": "8.2.0"
