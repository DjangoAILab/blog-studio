{
  "name": "@blog-studio/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "node dist/server/cli.js auth",
    "build": "vite build && tsc -p tsconfig.server.json",
    "dev": "vite",
