  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
