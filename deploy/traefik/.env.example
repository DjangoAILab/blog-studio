BLOG_STUDIO_IMAGE=blog-studio:local
BLOG_STUDIO_VCS_REF=development
BLOG_STUDIO_UID=1000
BLOG_STUDIO_GID=1000
BLOG_STUDIO_LOCAL_PORT=4310
BLOG_STUDIO_TMPFS_SIZE=1g
BLOG_STUDIO_HOSTNAME=blog-editor.internal.wj2015.com
BLOG_STUDIO_PREVIEW_HOSTNAME=blog-editor-preview.internal.wj2015.com
BLOG_STUDIO_ALLOWED_ORIGINS=https://blog-editor.internal.wj2015.com
BLOG_STUDIO_TRAEFIK_NETWORK=home-server_default
BLOG_STUDIO_DATA_PATH=./data
BLOG_STUDIO_AGENT_RUNTIME_DIRECTORY=/data/agent-runtime
BLOG_STUDIO_CONFIG_PATH=./config/blog-studio.yml
BLOG_STUDIO_WORKSPACE_PATH=./workspace
BLOG_STUDIO_COOKIE_SECRET_PATH=./secrets/cookie_secret
# Optional vision adapter. Keep the key file owner-only (0600) and never commit it.
# BLOG_STUDIO_VISION_ENDPOINT=http://cliproxy.internal/v1/chat/completions
# BLOG_STUDIO_VISION_MODEL=minimax-m3
# BLOG_STUDIO_VISION_API_KEY_FILE=/run/secrets/vision_api_key
# BLOG_STUDIO_VISION_API_KEY_PATH=./secrets/vision_api_key
